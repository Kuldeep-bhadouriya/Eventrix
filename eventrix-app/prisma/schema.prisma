generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  password          String?
  role              UserRole       @default(STUDENT)
  status            UserStatus     @default(ACTIVE)
  avatar            String?
  emailVerified     DateTime?      @db.Timestamptz(6)
  profileCompleted  Boolean        @default(false)
  phone             String?
  collegeRollNumber String?
  semester          String?
  department        String?
  suspendedAt       DateTime?      @db.Timestamptz(6)
  bannedAt          DateTime?      @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  accounts          Account[]
  certificates      Certificate[]
  notifications     Notification[]
  organizer         Organizer?
  registrations     Registration[]
  submittedReports  Report[]
  sessions          Session[]
  adminAuditLogs    AdminAuditLog[]
  notificationCampaignsCreated NotificationCampaign[] @relation("NotificationCampaignCreator")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([profileCompleted])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organizer {
  id               String   @id @default(cuid())
  userId           String   @unique
  organizationName String
  logo             String?
  bio              String?
  socialLinks      Json?
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  events           Event[]
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([verified])
  @@map("organizers")
}

model Event {
  id              String         @id @default(cuid())
  title           String
  description     String
  date            DateTime       @db.Timestamptz(6)
  time            String
  endTime         String?
  venue           String
  capacity        Int
  registeredCount Int            @default(0)
  organizerId     String
  category        String
  tags            String[]
  bannerUrl       String?
  status          EventStatus    @default(DRAFT)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  certificates    Certificate[]
  organizer       Organizer      @relation(fields: [organizerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reports         Report[]
  registrations   Registration[]

  @@index([organizerId])
  @@index([status])
  @@index([date])
  @@index([category])
  @@map("events")
}

model Registration {
  id           String             @id @default(cuid())
  userId       String
  eventId      String
  registeredAt DateTime           @default(now()) @db.Timestamptz(6)
  status       RegistrationStatus @default(REGISTERED)
  checkInTime  DateTime?          @db.Timestamptz(6)
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("registrations")
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  templateUrl String?
  downloadUrl String?
  issuedAt    DateTime @default(now()) @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("certificates")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  campaignId String?
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  campaign  NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([campaignId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationCampaign {
  id              String                     @id @default(cuid())
  title           String
  message         String
  role            String
  status          NotificationCampaignStatus @default(DRAFT)
  scheduledFor    DateTime?                  @db.Timestamptz(6)
  sentAt          DateTime?                  @db.Timestamptz(6)
  recipientsCount Int                        @default(0)
  createdById     String
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy       User                       @relation("NotificationCampaignCreator", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notifications   Notification[]

  @@index([status])
  @@index([scheduledFor])
  @@index([createdAt])
  @@map("notification_campaigns")
}

model Report {
  id         String          @id @default(cuid())
  reporterId String?
  eventId    String?
  entityType ReportEntityType
  entityId   String
  reason     String
  message    String?
  status     ReportStatus    @default(OPEN)
  priority   ReportPriority  @default(MEDIUM)
  adminNotes String?
  resolvedAt DateTime?       @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  event      Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reporter   User?           @relation(fields: [reporterId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([reporterId])
  @@index([eventId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("reports")
}

model AdminSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String   @default("general")
  value       Json
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([category])
  @@map("admin_settings")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  body      String
  variables String[] @default([])
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("email_templates")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

enum UserRole {
  STUDENT
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  COMPLETED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

enum ReportEntityType {
  EVENT
  USER
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationCampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}
