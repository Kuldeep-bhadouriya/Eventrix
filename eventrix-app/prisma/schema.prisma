generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  password          String?
  role              UserRole       @default(STUDENT)
  avatar            String?
  emailVerified     DateTime?      @db.Timestamptz(6)
  profileCompleted  Boolean        @default(false)
  phone             String?
  collegeRollNumber String?
  semester          String?
  department        String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  accounts          Account[]
  certificates      Certificate[]
  notifications     Notification[]
  organizer         Organizer?
  registrations     Registration[]
  sessions          Session[]

  @@index([email])
  @@index([role])
  @@index([profileCompleted])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organizer {
  id               String   @id @default(cuid())
  userId           String   @unique
  organizationName String
  logo             String?
  bio              String?
  socialLinks      Json?
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  events           Event[]
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([verified])
  @@map("organizers")
}

model Event {
  id              String         @id @default(cuid())
  title           String
  description     String
  date            DateTime       @db.Timestamptz(6)
  time            String
  endTime         String?
  venue           String
  capacity        Int
  registeredCount Int            @default(0)
  organizerId     String
  category        String
  tags            String[]
  bannerUrl       String?
  status          EventStatus    @default(DRAFT)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  certificates    Certificate[]
  organizer       Organizer      @relation(fields: [organizerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  registrations   Registration[]

  @@index([organizerId])
  @@index([status])
  @@index([date])
  @@index([category])
  @@map("events")
}

model Registration {
  id           String             @id @default(cuid())
  userId       String
  eventId      String
  registeredAt DateTime           @default(now()) @db.Timestamptz(6)
  status       RegistrationStatus @default(REGISTERED)
  checkInTime  DateTime?          @db.Timestamptz(6)
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("registrations")
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  templateUrl String?
  downloadUrl String?
  issuedAt    DateTime @default(now()) @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("certificates")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

enum UserRole {
  STUDENT
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  COMPLETED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}
